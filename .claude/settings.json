{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git rev-list*)",
      "Bash(git check-ignore*)",
      "Bash(git add*)",
      "Bash(git fetch*)",
      "Bash(npx tsc*)",
      "Bash(npx playwright*)",
      "Bash(conda run --no-capture-output -n tradingagents python -m pytest*)"
    ],
    "deny": [
      "Bash(git push upstream*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
