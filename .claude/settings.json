{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-branch.sh\"",
            "statusMessage": "检查当前分支…",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 180,
            "rewakeSummary": "tsc 类型检查失败",
            "statusMessage": "后台类型检查…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git rev-list*)",
      "Bash(git check-ignore*)",
      "Bash(git add*)",
      "Bash(git fetch*)",
      "Bash(npx tsc*)",
      "Bash(conda run -n tradingagents python -m pytest*)"
    ],
    "deny": [
      "Bash(git push upstream*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
